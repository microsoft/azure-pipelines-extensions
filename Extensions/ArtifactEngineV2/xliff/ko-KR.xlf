<?xml version="1.0" encoding="utf-8"?>
<xliff version="1.2">
  <file original="lib.json" source-language="en-US" target-language="ko-KR" datatype="plaintext">
    <body>
      <trans-unit xmlns="" id="loc.messages.ArtifactPathIsHardLinked">
        <source>Artifact path %s already exists as a hard-linked file and was rejected.</source>
        <target state="translated">아티팩트 경로 %s이(가) 이미 하드 링크된 파일로 존재하여 거부되었습니다.</target>
        <note />
      </trans-unit>
      <trans-unit xmlns="" id="loc.messages.ArtifactPathIsSpecialFile">
        <source>Artifact path %s already exists as a non-regular file (e.g. a device, pipe, or socket) and was rejected.</source>
        <target state="translated">아티팩트 경로 %s이(가) 이미 일반 파일이 아닌 파일(예: 장치, 파이프 또는 소켓)로 존재하여 거부되었습니다.</target>
        <note />
      </trans-unit>
      <trans-unit xmlns="" id="loc.messages.ArtifactPathIsSymlink">
        <source>Artifact path %s already exists as a symbolic link and was rejected.</source>
        <target state="translated">아티팩트 경로 %s이(가) 이미 심볼릭 링크로 존재하여 거부되었습니다.</target>
        <note />
      </trans-unit>
      <trans-unit xmlns="" id="loc.messages.InvalidArtifactPath">
        <source>Artifact path %s resolves outside the download directory.</source>
        <target state="translated">아티팩트 경로 %s이(가) 다운로드 디렉터리 외부로 확인됩니다.</target>
        <note />
      </trans-unit>
      <trans-unit xmlns="" id="loc.messages.DownloadSummary">
        <source>Total Files: %s, Processed: %s, Skipped: %s, Failed: %s, Download time: %s secs, Download size: %s</source>
        <target state="translated">총 파일: %s, 처리됨: %s, 건너뜀: %s, 실패함: %s, 다운로드 시간: %s초, 다운로드 크기: %s</target>
        <note />
      </trans-unit>
      <trans-unit xmlns="" id="loc.messages.DownloadedTo">
        <source>Downloaded %s to %s</source>
        <target state="translated">%s을(를) %s에 다운로드함</target>
        <note />
      </trans-unit>
      <trans-unit xmlns="" id="loc.messages.DownloadingTo">
        <source>Downloading %s to %s</source>
        <target state="translated">%s을(를) %s에 다운로드하는 중</target>
        <note />
      </trans-unit>
      <trans-unit xmlns="" id="loc.messages.FailedRequest">
        <source>Failed request: (statusCode)</source>
        <target state="translated">실패한 요청: (statusCode)</target>
        <note />
      </trans-unit>
      <trans-unit xmlns="" id="loc.messages.FailedToParseResponse">
        <source>Failed to parse response body: %s, got error : %s</source>
        <target state="translated">응답 본문 %s을(를) 구문 분석하지 못했습니다. 오류: %s</target>
        <note />
      </trans-unit>
      <trans-unit xmlns="" id="loc.messages.RetryingDownload">
        <source>Retrying download of %s, retry count: %s</source>
        <target state="translated">%s 다운로드를 다시 시도하는 중, 다시 시도 횟수: %s회</target>
        <note />
      </trans-unit>
      <trans-unit xmlns="" id="loc.messages.SkippingItem">
        <source>Skipped processing item %s</source>
        <target state="translated">항목 %s의 처리를 건너뜀</target>
        <note />
      </trans-unit>
      <trans-unit xmlns="" id="loc.messages.UnableToReadDirectory">
        <source>Unable to read directory %s. Error: %s</source>
        <target state="translated">디렉터리 %s을(를) 읽을 수 없습니다. 오류: %s</target>
        <note />
      </trans-unit>
      <trans-unit xmlns="" id="loc.messages.UnhandledException">
        <source>artifact-engine-v2: unhandled exception %s</source>
        <target state="translated">artifact-engine-v2: 처리되지 않은 예외 %s</target>
        <note />
      </trans-unit>
      <trans-unit xmlns="" id="loc.messages.UnhandledRejection">
        <source>artifact-engine-v2: unhandled rejection %s</source>
        <target state="translated">artifact-engine-v2: 처리되지 않은 거부 %s</target>
        <note />
      </trans-unit>
    </body>
  </file>
</xliff>